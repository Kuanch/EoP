# Environment Configuration Example
# Copy this file to .env and fill in your values

# Application Settings
ENVIRONMENT=production

# Database Configuration
# For SQLite (default, single instance)
DATABASE_URL=sqlite:///./data/users.db

# For PostgreSQL (uncomment when using postgres service)
# DATABASE_URL=postgresql://fastapi:your_password@postgres:5432/fastapi_users

# Cloudflare Tunnel Token
# Get this from: https://dash.cloudflare.com/ -> Zero Trust -> Access -> Tunnels
# Format: eyJh... (long base64 string)
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# PostgreSQL Password (if using postgres service)
POSTGRES_PASSWORD=changeme_to_secure_password

# Optional: Secret key for sessions (future enhancement)
# SECRET_KEY=generate_with_openssl_rand_hex_32
